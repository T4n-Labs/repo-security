# Template file for 'metasploit'
pkgname=metasploit
version=6.4.18
revision=1
archs="x86_64"
build_style=fetch
hostmakedepends="binutils tar xz zstd"
depends="postgresql nmap"
short_desc="Advanced open-source platform for developing, testing, and using exploit code"
maintainer="gh0st4n <darskevoid@gmail.com>"
distributor="gh0st4n <darskevoid@gmail.com>"
license="BSD-3-Clause"
homepage="https://www.metasploit.com"
distfiles="https://downloads.metasploit.com/data/releases/metasploit-framework/metasploitframework_${version}+20241009113623-1rapid7-1_amd64.deb"
checksum="GANTI_DENGAN_SHA256_NANTI"

do_extract() {
    # 1. Ekstrak arsip .deb (yang merupakan arsip 'ar')
    ar x "${XBPS_SRCDISTDIR}/${pkgname}-${version}/"*.deb
    
    # 2. Ekstrak payload data (data.tar.xz atau data.tar.zst) langsung ke wrksrc
    tar xf data.tar.* -C "${wrksrc}"
}

do_install() {
    # Omnibus menginstal semuanya di /opt/metasploit-framework
    # Kita pindahkan struktur /opt tersebut ke DESTDIR kita
    vcopy "opt/metasploit-framework" "opt"

    # Buat symlink di /usr/bin agar perintah bisa dipanggil dari mana saja
    vmkdir usr/bin
    for cmd in msfconsole msfvenom msfdb msfupdate; do
        ln -s "/opt/metasploit-framework/bin/${cmd}" "${DESTDIR}/usr/bin/${cmd}"
    done

    # Tambahkan catatan khusus Void Linux
    vdoc "${FILESDIR}/README.voidlinux"
}